# Multiple Gemini API keys separated by comma (for seamless fallback when quota expires)
# You can use 1 key or multiple keys. System will automatically switch keys when quota is exceeded.
GEMINI_API_KEY=your_first_key_here,your_second_key_here,your_third_key_here

# Optional: Whapi settings if you want to send replies via Whapi
# WHAPI_TOKEN=your_whapi_token
# WHAPI_BASE_URL=https://gate.whapi.cloud
